@@ -2623,6 +2623,16 @@ var MediabunnyServer = (() => {
           codecContext.setOption("preset", "12");
         }
       }
+      // [seam patch] Tag 8-bit SDR YUV output as BT.709 limited-range before the
+      // codec opens, so the encoder writes VUI colour info and getDecoderConfig
+      // reports a complete colorSpace (which makes mediabunny's muxers emit a
+      // colr box). The RGB->YUV conversion in encode() is forced to match.
+      if (pixelFormat === NodeAv4.AV_PIX_FMT_YUV420P || pixelFormat === NodeAv4.AV_PIX_FMT_YUVA420P) {
+        codecContext.colorPrimaries = NodeAv4.AVCOL_PRI_BT709;
+        codecContext.colorTrc = NodeAv4.AVCOL_TRC_BT709;
+        codecContext.colorSpace = NodeAv4.AVCOL_SPC_BT709;
